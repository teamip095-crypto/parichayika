# ==============================================================================
# PARICHAYIKA 2026 - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

# Node / Deployment Environment
NODE_ENV=production
PORT=3000

# Authentication & Session Security (Server-side Only)
JWT_SECRET=your_jwt_secret_key_here

# PostgreSQL / Supabase Cloud Database Connection URL (Server-side Only)
# Example Supabase Transaction Pooler: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Supabase Cloud Storage (Server-side Only)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=parichayika-media

# Business & Payment Configuration
UPI_ID=9301056006@paytm
UPI_PAYEE_NAME=Parichayika Powered by Indian Press

# Public Application URL (Optional / Production Domain)
PUBLIC_APP_URL=https://parichayika.in

# WhatsApp Notification Webhook / Gateway (Optional)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
